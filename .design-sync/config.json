{
  "projectId": "d7027915-eb54-4242-83c4-171e2fb6018e",
  "shape": "package",
  "pkg": "@harnessio/ui",
  "globalName": "HarnessUI",
  "buildCmd": "pnpm -F \"@harnessio/ui...\" build && node .design-sync/stage-pkg.mjs",
  "extraEntries": [
    "../../theme-root.jsx",
    "./dist/context.js"
  ],
  "provider": {
    "component": "ThemeRoot",
    "props": {
      "mode": "light"
    },
    "inner": {
      "component": "TooltipProvider"
    }
  },
  "extraFonts": [
    "../../fonts.css"
  ],
  "componentSrcMap": {
    "IconV2DisplayName": null,
    "IllustrationsNameMap": null,
    "IconNameMapV2": null,
    "LogoNameMapV2": null,
    "SymbolNameMap": null
  },
  "runtimeFontPrefixes": [
    "Segoe WPC",
    "Ubuntu Mono"
  ],
  "entry": "./.design-sync/.cache/pkg/dist/components.js",
  "libOverrides": {
    "dts.mjs": "emit per-member props for compound components (stock emits ComponentType<any>)",
    "emit.mjs": "write compound member prop types from dts fork (memberTypes/namespaceOnly)"
  },
  "dtsPropsFor": {
    "Text": "  style?: React.CSSProperties;\n  className?: string;\n  id?: string;\n  children?: React.ReactNode;\n  variant?: \"heading-hero\" | \"heading-section\" | \"heading-default\" | \"heading-subsection\" | \"heading-base\" | \"heading-small\" | \"body-normal\" | \"body-single-line-normal\" | \"body-strong\" | \"body-single-line-strong\" | \"body-code\" | \"caption-normal\" | \"caption-light\" | \"caption-strong\" | \"caption-code\" | \"caption-single-line-normal\";\n  color?: \"foreground-1\" | \"foreground-2\" | \"foreground-3\" | \"foreground-4\" | \"brand\" | \"success\" | \"danger\" | \"warning\" | \"merged\" | \"disabled\" | \"inherit\";\n  wrap?: \"wrap\" | \"nowrap\" | \"balance\" | \"pretty\";\n  align?: \"left\" | \"center\" | \"right\";\n  truncate?: boolean;\n  lineClamp?: 1 | 2 | 3 | 4 | 5 | 6 | \"default\";\n  /** Shorthand for changing the default rendered element into a semantically appropriate alternative. */\n  as?: \"span\" | \"div\" | \"p\" | \"h1\" | \"h2\" | \"h3\" | \"h4\" | \"h5\" | \"h6\" | \"label\" | \"li\" | \"code\" | \"blockquote\" | \"cite\" | \"abbr\" | \"address\" | \"caption\" | \"dd\" | \"del\" | \"dt\";\n  /** Change the default rendered element for the one passed as a child, merging their props and behavior. */\n  asChild?: boolean;"
  },
