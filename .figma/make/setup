#!/bin/bash
set -e

# System toolchain for the Canary design-system monorepo (pnpm workspace).
# Runs once when Make Local first sees this repo; cached after that.

echo "Checking system dependencies..."

# Node (repo requires >=18.17.1)
NODE_VERSION="$(node --version 2>/dev/null || echo "none")"
if [[ "$NODE_VERSION" == "none" ]]; then
  echo "Installing node"
  brew install node
fi
echo "Node ${NODE_VERSION} OK"

# pnpm — the repo pins pnpm@9.5.0 via packageManager and blocks other managers.
# Prefer Corepack so the pinned version is used automatically.
if command -v corepack >/dev/null 2>&1; then
  echo "Enabling pnpm via Corepack"
  corepack enable >/dev/null 2>&1 || true
elif ! command -v pnpm >/dev/null 2>&1; then
  echo "Installing pnpm"
  npm install -g pnpm@9.5.0
fi
echo "pnpm $(pnpm --version 2>/dev/null || echo "pending") OK"

echo "System dependencies verified."
