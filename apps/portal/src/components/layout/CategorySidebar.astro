---
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import { getActiveCategory } from "../../lib/nav-categories";

const { sidebar } = Astro.locals.starlightRoute;
const active = getActiveCategory(Astro.url.pathname);

// Keep only the sidebar groups that belong to the active top-nav category.
// Render them as-is (with their group headings) so items keep the same nested
// link styling they have under Docs, rather than being promoted to top-level.
const groups = sidebar.filter(
  (entry: any) =>
    entry.type === "group" && active?.groups.includes(entry.label),
);

// Always hide the top-level parent group headings and lock their lists open via
// the `category-sidebar--flat` class below. This keeps items inside their group
// (so they retain the nested link/icon styling) while removing the collapsible
// accordion sections entirely — for every category, including multi-group ones
// (Docs) and distinctly-named ones (Patterns → "PLG Patterns"). Nested sub-groups
// (Button, Icon Button, …) are scoped out by the CSS and stay collapsible.
---

<div class="category-sidebar category-sidebar--flat">
  <SidebarPersister>
    <SidebarSublist sublist={groups} />
  </SidebarPersister>
</div>
