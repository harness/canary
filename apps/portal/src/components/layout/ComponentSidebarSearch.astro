---
import { getActiveCategory } from "../../lib/nav-categories";

// Only render inside the Components section. The global search in the top nav
// covers the whole site; this box is scoped to filter just the component list
// in the sidebar below.
const active = getActiveCategory(Astro.url.pathname);
const isComponents = active?.id === "components";
---

{
  isComponents && (
    <div class="cn-component-search flex-shrink-0 px-cn-sm pt-cn-md pb-cn-sm">
      <label class="cn-component-search-field">
        <svg
          class="cn-component-search-icon"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="11"
            cy="11"
            r="7"
            stroke="currentColor"
            stroke-width="2"
          />
          <path
            d="m20 20-3-3"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
        <input
          type="search"
          placeholder="Search components"
          aria-label="Search components"
          autocomplete="off"
        />
      </label>
    </div>
  )
}

<script is:inline>
  // Guards on the presence of the search box, so this safely no-ops on pages
  // outside the Components section where the input is not rendered.
  (() => {
    const init = () => {
      const input = document.querySelector(".cn-component-search input");
      const sidebar = document.querySelector(".cn-sidebar-scroll-inner");
      if (!input || !sidebar) return;

      const topList = sidebar.querySelector("ul.top-level > li > details > ul");
      if (!topList) return;

      const items = Array.from(topList.children);
      // Remember each group's initial open state so we can restore it when
      // the query is cleared, instead of leaving every group expanded.
      const groups = items
        .map((li) => li.querySelector(":scope > details"))
        .filter(Boolean);
      const originalOpen = new Map(
        groups.map((d) => [d, d.hasAttribute("open")]),
      );

      const matches = (el, term) =>
        (el.textContent || "").trim().toLowerCase().includes(term);

      const filter = (raw) => {
        const term = raw.trim().toLowerCase();

        items.forEach((li) => {
          const group = li.querySelector(":scope > details");

          if (group) {
            const summary = group.querySelector(":scope > summary");
            const subItems = Array.from(
              group.querySelectorAll(":scope > ul > li"),
            );
            const labelMatch = term !== "" && summary && matches(summary, term);

            let groupHasMatch = false;
            subItems.forEach((subLi) => {
              const link = subLi.querySelector("a");
              const show =
                term === "" || labelMatch || (link && matches(link, term));
              subLi.classList.toggle("hidden", !show);
              if (show) groupHasMatch = true;
            });

            li.classList.toggle("hidden", term !== "" && !groupHasMatch);

            if (term === "") {
              group.toggleAttribute("open", originalOpen.get(group));
            } else if (groupHasMatch) {
              group.setAttribute("open", "");
            }
          } else {
            const link = li.querySelector(":scope > a");
            const show = term === "" || (link && matches(link, term));
            li.classList.toggle("hidden", !show);
          }
        });
      };

      input.addEventListener("input", () => filter(input.value));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
