---
import DocTemplate from "./DocTemplate.astro";
import SplashTemplate from "./SplashTemplate.astro";
import HomeTemplate from "./HomeTemplate.astro";

const { template, home } = Astro.locals.starlightRoute.entry.data;
---

{
  home ? (
    <HomeTemplate>
      <slot />
    </HomeTemplate>
  ) : template === "doc" ? (
    <DocTemplate>
      <slot />
    </DocTemplate>
  ) : (
    <SplashTemplate>
      <slot />
    </SplashTemplate>
  )
}
