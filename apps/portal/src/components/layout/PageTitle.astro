---
import { StatusBadge } from "@harnessio/ui/components";

// The full-width landing page provides its own hero headline, so suppress the
// default page title there.
const { title, beta, home } = Astro.locals.starlightRoute.entry.data;
---

{
  !home && (
    <div class="flex items-center gap-cn-xs">
      <h1 id="_top">{title}</h1>
      {beta && (
        <StatusBadge variant="outline" theme="info" size="sm">
          beta
        </StatusBadge>
      )}
    </div>
  )
}
