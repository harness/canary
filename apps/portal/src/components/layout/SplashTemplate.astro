---
import Search from "@astrojs/starlight/components/Search.astro";
import CategorySidebar from "./CategorySidebar.astro";
import TopNav from "./TopNav.astro";
---

<div class="flex flex-col min-h-screen bg-cn-1">
  <!-- Top navigation -->
  <TopNav />

  <div class="flex flex-1 min-h-0">
    <!-- Sidebar -->
    <nav
      class="cn-portal-sidebar flex flex-col w-[248px] shrink-0 sticky top-14 h-[calc(100vh-3.5rem)] border-r border-cn-3"
    >
      <!-- Search -->
      <div class="cn-sidebar-search flex-shrink-0 px-cn-sm pt-cn-md pb-cn-sm">
        <Search />
      </div>

      <!-- Scrollable nav -->
      <div class="cn-sidebar-scroll flex-1 min-h-0 overflow-hidden">
        <div
          class="cn-sidebar-scroll-inner h-full overflow-y-auto overscroll-contain px-cn-sm pb-cn-md"
        >
          <CategorySidebar />
        </div>
      </div>
    </nav>

    <!-- Content centered in remaining space -->
    <div class="flex-1 flex justify-center" style="padding-top: 20px;">
      <div class="w-full" style="max-width: 1060px; padding: 0 40px;">
        <slot />
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const selected = document.querySelector(
      '.cn-sidebar-scroll-inner a[aria-current="page"]',
    );
    if (selected) {
      selected.scrollIntoView({ block: "center", behavior: "instant" });
    }

    // Copy button enhancements (delayed to ensure EC has rendered)
    setTimeout(() => {
      document.querySelectorAll(".expressive-code").forEach((block) => {
        const lines = block.querySelectorAll(".ec-line");
        const copyDiv = block.querySelector(".copy") as HTMLElement | null;
        const btn = copyDiv?.querySelector("button");

        // Center copy button for single-line code blocks
        if (lines.length <= 1 && copyDiv) {
          const pre = block.querySelector("pre");
          if (pre) {
            const preRect = pre.getBoundingClientRect();
            const copyRect = copyDiv.getBoundingClientRect();
            const currentTop = copyRect.top - preRect.top;
            const targetTop = (preRect.height - copyRect.height) / 2;
            const offset = targetTop - currentTop;
            const currentInset =
              parseFloat(getComputedStyle(copyDiv).insetBlockStart) || 0;
            copyDiv.style.setProperty(
              "inset-block-start",
              `${currentInset + offset}px`,
              "important",
            );
          }
        }

        // Swap icon to checkmark on click
        if (btn) {
          btn.addEventListener("click", () => {
            btn.classList.add("copied");
            setTimeout(() => btn.classList.remove("copied"), 2000);
          });
        }
      });
    }, 100);
  });
</script>
