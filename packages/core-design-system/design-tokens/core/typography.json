{
  "tracking": {
    "tighter": {
      "$type": "letterSpacing",
      "$value": "-0.05em",
      "$description": "Legacy Platform UI used token (tracking-cn-tighter). Temporary; product API prefers tight / normal / wide."
    },
    "tight": {
      "$type": "letterSpacing",
      "$value": "-0.02em",
      "$description": "Headings"
    },
    "normal": {
      "$type": "letterSpacing",
      "$value": "0em",
      "$description": "Default body text"
    },
    "wide": {
      "$type": "letterSpacing",
      "$value": "0.025em",
      "$description": "Improved readability"
    }
  },
