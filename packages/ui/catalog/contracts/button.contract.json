  "usage": {
    "do": [
      {
        "id": "do-1",
        "statement": "Use primary for the single highest-priority action in a local context."
      },
      {
        "id": "do-2",
        "statement": "Use concise verb-led labels that make the result of activation predictable."
      },
      {
        "id": "do-3",
        "statement": "Use Button for action collections and toolbars, including controls that schedule, group, stop, or otherwise change a resource."
      },
      {
        "id": "do-4",
        "statement": "Use Button when a control such as Get Started begins or advances an onboarding flow in place."
      },
      {
        "id": "do-5",
        "statement": "Use loading for pending actions and allow Promise-returning onClick handlers to manage it automatically."
      },
      {
        "id": "do-6",
        "statement": "Use IconV2 children for contract-compatible icon composition."
      }
    ],
    "dont": [
      {
        "id": "dont-1",
        "statement": "Use Button as a visual container for non-interactive content."
      },
      {
        "id": "dont-2",
        "statement": "Use Button, its link variant, or asChild for ordinary navigation; use Link for destinations."
      },
      {
        "id": "dont-3",
        "statement": "Recreate a button-styled Link locally; propose the pattern to the design system if a destination requires primary Button prominence."
      },
      {
        "id": "dont-4",
        "statement": "Use iconOnly without an accessible name and a clear explanation of the action."
      },
      {
        "id": "dont-5",
        "statement": "Use success or danger themes on AI, transparent, link, or icon-only Buttons."
      },
      {
        "id": "dont-6",
        "statement": "Use rounded on a text Button; migrate deprecated TextRounded Buttons to the equivalent standard-shape Button."
      },
      {
        "id": "dont-7",
        "statement": "Add local color, size, padding, typography, or radius overrides that recreate an unsupported variant."
      },
      {
        "id": "dont-8",
        "statement": "Use disabled styling as the only explanation for why an action is unavailable."
      }
    ],
    "relatedComponents": ["Link", "ButtonGroup", "SplitButton", "Toggle"]
  },
