{
  "$schema": "./component-manifest.schema.json",

  "id": "canary.{component-kebab}",
  "status": "draft",

  "code": {
    "package": "@harnessio/ui",
    "export": "{ComponentName}",
    "import": "import { {ComponentName} } from '@harnessio/ui/components'",
    "path": "packages/ui/src/components/{component-folder}/{component}.tsx"
  },

  "figma": {
    "library": "HDS | Components 3.0",
    "fileKey": "AIgjIyUzcuZzuVnuoOyhQE",
    "name": "{ComponentName}",
    "exampleNodeId": "{node}:{frame}",
    "codeConnect": "packages/ui/src/components/{component-folder}/{component}.figma.ts",
    "publishStatus": "published"
  },

  "purpose": {
    "summary": "One sentence describing what this component does and when to use it.",
    "useWhen": [
      "Use case 1",
      "Use case 2"
    ],
    "doNotUseWhen": [
      "Anti-pattern 1",
      "Alternative component reference"
    ]
  },

  "props": {
    "shared": [
      {
        "name": "variant",
        "type": "enum",
        "values": ["primary", "secondary"],
        "default": "primary"
      }
    ],
    "designOnly": [],
    "codeOnly": []
  },

  "tokens": {
    "rootClass": "cn-{component}",
    "rule": "semantic-only",
    "refs": {
      "size.md": "{component}.size.md",
      "text.color": "text.cn-1"
    }
  },

  "governance": {
    "rulesDocs": [
      "../docs/system/accessibility.md",
      "../docs/system/color-system.md",
      "../docs/system/interaction-states.md",
      "../docs/system/visual-primitives.md",
      "./{component}.md"
    ],
    "note": "Component-specific pattern rules and decision framework.",
    "tokenStatus": "Status of token ref verification."
  }
}
