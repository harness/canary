{
  "openapi": "3.0.0",
  "info": {
    "title": "{ComponentName} Component Skill",
    "description": "[AUTHORED] One sentence description of the component and its primary use case",
    "version": "1.4.1",
    "x-skill-id": "canary.{component-kebab}",
    "x-skill-status": "stable",
    "x-skill-package": "@harnessio/ui"
  },
  "servers": [],
  "paths": {
    "/components/{component-kebab}": {
      "post": {
        "summary": "Create a {ComponentName} component",
        "description": "[GENERATED] Generate or validate a {ComponentName} component instance with specified props",
        "operationId": "create{ComponentName}",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "[AUTHORED] Primary prop description"
                  },
                  "variant": {
                    "type": "string",
                    "enum": ["option1", "option2"],
                    "default": "option1",
                    "description": "[AUTHORED] Style variant description"
                  }
                },
                "required": ["label"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ComponentName} component created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "componentId": {
                      "type": "string",
                      "description": "Unique identifier for the component instance"
                    },
                    "jsx": {
                      "type": "string",
                      "description": "Generated JSX/TSX code"
                    },
                    "props": {
                      "type": "object",
                      "description": "Resolved prop values with defaults"
                    },
                    "accessibility": {
                      "type": "object",
                      "description": "ARIA attributes and accessibility info"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid {ComponentName} configuration"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "{ComponentName}Props": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "variant": {
            "type": "string",
            "enum": ["option1", "option2"]
          }
        }
      }
    }
  },
  "x-governance": {
    "systemRules": [
      "docs/system/accessibility.md",
      "docs/system/interaction-states.md",
      "docs/system/color-system.md",
      "docs/system/visual-primitives.md"
    ],
    "componentRules": [
      "schemas/{component-kebab}.md"
    ]
  },
  "x-internal-manifest": "schemas/{component-kebab}.manifest.json"
}
