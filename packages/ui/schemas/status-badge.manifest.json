{
  "$schema": "https://your-org.com/schemas/component-manifest-v1.json",
  "id": "canary.status-badge",
  "status": "stable",

  "code": {
    "package": "@harnessio/ui",
    "export": "StatusBadge",
    "import": "import { StatusBadge } from '@harnessio/ui/components'",
    "path": "packages/ui/src/components/status-badge/status-badge.tsx"
  },

  "figma": {
    "library": "Harness Design System",
    "fileKey": "ABC123XYZ",
    "name": "StatusBadge",
    "exampleNodeId": "1234:5678",
    "componentKey": "1A2B3C:status-badge",
    "componentSetKey": null,
    "variantPropertyMap": {
      "variant": "variant",
      "theme": "theme",
      "size": "size"
    },
    "publishStatus": "published",
    "enforceSync": true
  },

  "purpose": {
    "summary": "Display a status indicator with semantic theme (success, warning, error) and optional animation",
    "useWhen": [
      "Communicating the state of a system, process, or entity (active, pending, error, warning)",
      "Labeling a status alongside other metadata in tables, lists, or cards",
      "Showing pulse animation for real-time status (e.g., 'currently processing')"
    ],
    "doNotUseWhen": [
      "Showing count badges (use CounterBadge instead)",
      "Displaying actionable tags or filters (use Tag component)",
      "Showing progress or completion percentage (use Progress component)"
    ]
  },

  "props": {
    "shared": [
      {
        "name": "variant",
        "type": "enum",
        "values": ["primary", "secondary", "outline", "ghost", "status"],
        "default": "primary",
        "figmaProperty": "variant",
        "description": "Component style variant; 'status' enables pulse animation and indicator dot"
      },
      {
        "name": "theme",
        "type": "enum",
        "values": ["muted", "success", "warning", "danger", "info", "merged", "risk"],
        "default": "muted",
        "figmaProperty": "theme",
        "description": "Semantic color theme indicating the status type"
      },
      {
        "name": "size",
        "type": "enum",
        "values": ["sm", "md"],
        "default": "md",
        "figmaProperty": "size",
        "description": "Badge size"
      }
    ],
    "designOnly": [
      {
        "name": "pulse",
        "type": "boolean",
        "figmaProperty": "pulse",
        "transform": "style-only",
        "notes": "Only works with variant='status'; controls animation on indicator dot, compiled to CSS animation"
      }
    ],
    "codeOnly": [
      {
        "name": "icon",
        "type": "string",
        "trigger": "appearance-override",
        "notes": "Optional IconV2 name; Figma doesn't support icon picker, agents must provide explicit icon names"
      },
      {
        "name": "children",
        "type": "node",
        "trigger": "content",
        "notes": "Badge label/text content"
      },
      {
        "name": "className",
        "type": "string",
        "trigger": "a11y-only",
        "notes": "Additional CSS classes (Tailwind); should not override token-based styling"
      }
    ]
  },

  "tokens": {
    "rootClass": "cn-badge",
    "rule": "semantic-only",
    "refs": {
      "variant.primary": "badge.variant.primary",
      "variant.secondary": "badge.variant.secondary",
      "variant.outline": "badge.variant.outline",
      "variant.ghost": "badge.variant.ghost",
      "variant.status": "badge.variant.status",
      "theme.muted": "badge.theme.muted",
      "theme.success": "badge.theme.success",
      "theme.warning": "badge.theme.warning",
      "theme.danger": "badge.theme.danger",
      "theme.info": "badge.theme.info",
      "size.sm": "badge.size.sm",
      "size.md": "badge.size.md",
      "animation.pulse": "animation.pulse"
    }
  },

  "accessibility": {
    "role": "status",
    "notes": "Badge is a passive status indicator; not interactive. Children are announced as status updates. Icon (if present) should be decorative (aria-hidden)."
  },

  "states": [
    {
      "name": "base",
      "triggeredBy": {
        "source": "interaction",
        "ref": "none"
      },
      "description": "Default badge appearance"
    },
    {
      "name": "pulse",
      "triggeredBy": {
        "source": "prop",
        "ref": "pulse"
      },
      "description": "Animated pulse on status indicator dot (variant='status' only)"
    }
  ],

  "governance": {
    "rulesDocs": [
      "docs/system/accessibility.md",
      "docs/system/color-system.md",
      "docs/system/interaction-states.md",
      "docs/system/visual-primitives.md",
      "docs/system/typography.md",
      "docs/system/spacing.md",
      "docs/system/layout.md",
      "docs/system/shadows.md",
      "docs/system/component-architecture.md",
      "docs/system/design-to-code-flow.md",
      "docs/components/status-badge.md"
    ],
    "tokenStatus": "All color and animation tokens verified; size tokens pending audit"
  },

  "knownGaps": [
    "No built-in close/dismiss action (use wrapper component if needed)",
    "Pulse animation only works with variant='status'; other variants ignore the pulse prop"
  ],

  "examples": {
    "correct": [
      "<StatusBadge variant='status' theme='success' pulse>Active</StatusBadge>",
      "<StatusBadge variant='primary' theme='warning' icon='alert'>Attention needed</StatusBadge>",
      "<StatusBadge variant='secondary' theme='muted'>Draft</StatusBadge>"
    ],
    "incorrect": [
      "<StatusBadge variant='primary' pulse>Pulse on non-status variant (ignored)</StatusBadge>",
      "<StatusBadge onClick={() => {}}>Status badges are not interactive</StatusBadge>"
    ]
  }
}
