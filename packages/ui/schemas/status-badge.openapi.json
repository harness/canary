{
  "openapi": "3.0.0",
  "info": {
    "title": "StatusBadge Component Skill",
    "description": "Harness StatusBadge component for displaying status indicators. Five variants (primary, secondary, outline, ghost, status) and seven semantic themes (muted, success, warning, danger, info, merged, risk). The 'status' variant supports a pulse animation on the indicator dot.",
    "version": "1.0.0",
    "x-skill-id": "canary.status-badge",
    "x-skill-status": "stable",
    "x-skill-package": "@harnessio/ui"
  },
  "servers": [],
  "paths": {
    "/components/status-badge": {
      "post": {
        "summary": "Create a StatusBadge component",
        "description": "Generate or validate a StatusBadge component instance with specified props",
        "operationId": "createStatusBadge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusBadgeProps"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "StatusBadge component created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "componentId": {
                      "type": "string",
                      "description": "Unique identifier for the badge instance"
                    },
                    "jsx": {
                      "type": "string",
                      "description": "Generated JSX/TSX code"
                    },
                    "props": {
                      "type": "object",
                      "description": "Resolved prop values with defaults"
                    },
                    "accessibility": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "description": "ARIA role (status)"
                        },
                        "ariaLabel": {
                          "type": "string",
                          "description": "Accessible label"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid StatusBadge configuration"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StatusBadgeProps": {
        "type": "object",
        "description": "Props for the StatusBadge React component. Mirrors props in schemas/status-badge.manifest.json.",
        "properties": {
          "variant": {
            "type": "string",
            "enum": ["primary", "secondary", "outline", "ghost", "status"],
            "default": "primary",
            "description": "Component style variant; 'status' enables pulse animation and indicator dot",
            "x-provenance": "shared"
          },
          "theme": {
            "type": "string",
            "enum": ["muted", "success", "warning", "danger", "info", "merged", "risk"],
            "default": "muted",
            "description": "Semantic color theme indicating the status type",
            "x-provenance": "shared"
          },
          "size": {
            "type": "string",
            "enum": ["sm", "md"],
            "default": "md",
            "description": "Badge size",
            "x-provenance": "shared"
          },
          "pulse": {
            "type": "boolean",
            "description": "Animates the indicator dot. Only valid with variant='status'; other variants reject this prop.",
            "x-provenance": "designOnly"
          },
          "icon": {
            "type": "string",
            "description": "Optional IconV2 name. Figma has no icon picker, so agents must supply an explicit icon name. Not valid with variant='status'.",
            "x-provenance": "codeOnly",
            "x-trigger": "appearance-override"
          },
          "children": {
            "type": "string",
            "description": "Badge label/text content. Typed as React.ReactNode in code; represented here as a string for spec purposes.",
            "x-provenance": "codeOnly",
            "x-trigger": "content"
          },
          "className": {
            "type": "string",
            "description": "Additional Tailwind classes; must not override token-based styling",
            "x-provenance": "codeOnly",
            "x-trigger": "appearance-override"
          }
        },
        "required": ["variant"],
        "additionalProperties": false
      }
    }
  },
  "x-tokens": {
    "rootClass": "cn-badge",
    "rule": "semantic-only"
  },
  "x-accessibility": {
    "role": "status",
    "notes": "Passive status indicator; not interactive. Children are announced as status updates. A decorative icon should be aria-hidden."
  },
  "x-examples": {
    "correct": [
      "<StatusBadge variant='status' theme='success' pulse>Active</StatusBadge>",
      "<StatusBadge variant='primary' theme='warning' icon='alert'>Attention needed</StatusBadge>",
      "<StatusBadge variant='secondary' theme='muted'>Draft</StatusBadge>"
    ],
    "incorrect": [
      "<StatusBadge variant='primary' pulse>Pulse on non-status variant (rejected)</StatusBadge>",
      "<StatusBadge onClick={() => {}}>Status badges are not interactive</StatusBadge>"
    ]
  },
  "x-known-gaps": [
    "No built-in close/dismiss action (use a wrapper component if needed)",
    "Pulse animation only works with variant='status'; other variants reject the pulse prop"
  ],
  "x-governance": {
    "systemRules": [
      "docs/system/accessibility.md",
      "docs/system/color-system.md",
      "docs/system/interaction-states.md",
      "docs/system/visual-primitives.md",
      "docs/system/typography.md",
      "docs/system/spacing.md",
      "docs/system/shadows.md",
      "docs/system/component-architecture.md",
      "docs/system/design-to-code-flow.md"
    ],
    "componentRules": ["schemas/status-badge.md"]
  },
  "x-internal-manifest": "schemas/status-badge.manifest.json"
}
