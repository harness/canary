{
  "openapi": "3.0.0",
  "info": {
    "title": "StatusBadge Component Skill",
    "description": "Harness StatusBadge component for displaying status indicators with muted, success, warning, and error themes",
    "version": "1.0.0",
    "x-skill-id": "canary.status-badge",
    "x-skill-status": "stable",
    "x-skill-package": "@harnessio/ui"
  },
  "servers": [],
  "paths": {
    "/components/status-badge": {
      "post": {
        "summary": "Create a StatusBadge component",
        "description": "Generate or validate a StatusBadge component instance with specified props",
        "operationId": "createStatusBadge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "Badge text content"
                  },
                  "theme": {
                    "type": "string",
                    "enum": ["muted", "success", "warning", "error"],
                    "default": "muted",
                    "description": "Visual theme indicating status"
                  },
                  "icon": {
                    "type": "string",
                    "description": "Optional icon name from Harness icon library"
                  },
                  "closeable": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show close button"
                  }
                },
                "required": ["label"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "StatusBadge component created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "componentId": {
                      "type": "string",
                      "description": "Unique identifier for the badge instance"
                    },
                    "jsx": {
                      "type": "string",
                      "description": "Generated JSX/TSX code"
                    },
                    "props": {
                      "type": "object",
                      "description": "Resolved prop values with defaults"
                    },
                    "accessibility": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "description": "ARIA role (status)"
                        },
                        "ariaLabel": {
                          "type": "string",
                          "description": "Accessible label"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid StatusBadge configuration"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StatusBadgeProps": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "theme": {
            "type": "string",
            "enum": ["muted", "success", "warning", "error"]
          },
          "icon": { "type": "string" },
          "closeable": { "type": "boolean" }
        }
      }
    }
  },
  "x-governance": {
    "systemRules": [
      "docs/system/accessibility.md",
      "docs/system/interaction-states.md",
      "docs/system/color-system.md",
      "docs/system/visual-primitives.md"
    ],
    "componentRules": [
      "docs/components/status-badge.md"
    ]
  },
  "x-internal-manifest": "schemas/status-badge.manifest.json"
}
