{
  "openapi": "3.0.0",
  "info": {
    "title": "StatusBadge Component Skill",
    "description": "Display a status indicator with a semantic theme (muted, success, warning, danger, info, merged, risk) and optional pulse animation on the 'status' variant",
    "version": "1.4.1",
    "x-skill-id": "canary.status-badge",
    "x-skill-status": "stable",
    "x-skill-package": "@harnessio/ui"
  },
  "servers": [],
  "paths": {
    "/components/status-badge": {
      "post": {
        "summary": "Create a StatusBadge component",
        "description": "Generate or validate a StatusBadge component instance with specified props",
        "operationId": "createStatusBadge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusBadgeProps"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "StatusBadge component created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "componentId": {
                      "type": "string",
                      "description": "Unique identifier for the instance"
                    },
                    "jsx": {
                      "type": "string",
                      "description": "Generated JSX/TSX code"
                    },
                    "props": {
                      "type": "object",
                      "description": "Resolved prop values with defaults"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid StatusBadge configuration"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StatusBadgeProps": {
        "type": "object",
        "description": "Props for the StatusBadge React component. Generated from the manifest — do not edit by hand.",
        "properties": {
          "variant": {
            "type": "string",
            "enum": ["primary", "secondary", "outline", "ghost", "status"],
            "default": "primary",
            "description": "Component style variant; 'status' enables pulse animation and indicator dot. Required by the TypeScript type despite the CVA defaultVariants entry.",
            "x-provenance": "shared"
          },
          "theme": {
            "type": "string",
            "enum": ["muted", "success", "warning", "danger", "info", "merged", "risk"],
            "default": "muted",
            "description": "Semantic color theme indicating the status type",
            "x-provenance": "shared"
          },
          "size": {
            "type": "string",
            "enum": ["sm", "md"],
            "default": "md",
            "description": "Badge size",
            "x-provenance": "shared"
          },
          "pulse": {
            "type": "boolean",
            "description": "Only works with variant='status'; controls animation on indicator dot, compiled to CSS animation",
            "x-provenance": "designOnly",
            "x-transform": "style-only"
          },
          "icon": {
            "type": "string",
            "description": "Optional IconV2 name; Figma doesn't support icon picker, agents must provide explicit icon names",
            "x-provenance": "codeOnly",
            "x-trigger": "appearance-override"
          },
          "children": {
            "type": "string",
            "x-code-type": "node",
            "description": "Badge label/text content",
            "x-provenance": "codeOnly",
            "x-trigger": "content"
          },
          "className": {
            "type": "string",
            "description": "Additional CSS classes (Tailwind); should not override token-based styling",
            "x-provenance": "codeOnly",
            "x-trigger": "appearance-override"
          }
        },
        "required": ["variant"],
        "additionalProperties": false
      }
    }
  },
  "x-generated-from": "schemas/status-badge.manifest.json — regenerate with `pnpm ds-check --write`",
  "x-tokens": {
    "rootClass": "cn-badge",
    "rule": "semantic-only",
    "refs": {
      "variant.primary": "badge.variant.primary",
      "variant.secondary": "badge.variant.secondary",
      "variant.outline": "badge.variant.outline",
      "variant.ghost": "badge.variant.ghost",
      "variant.status": "badge.variant.status",
      "theme.muted": "badge.theme.muted",
      "theme.success": "badge.theme.success",
      "theme.warning": "badge.theme.warning",
      "theme.danger": "badge.theme.danger",
      "theme.info": "badge.theme.info",
      "size.sm": "badge.size.sm",
      "size.md": "badge.size.md",
      "animation.pulse": "animation.pulse"
    }
  },
  "x-accessibility": {
    "role": "status",
    "notes": "Badge is a passive status indicator; not interactive. Children are announced as status updates. Icon (if present) should be decorative (aria-hidden)."
  },
  "x-examples": {
    "correct": [
      "<StatusBadge variant='status' theme='success' pulse>Active</StatusBadge>",
      "<StatusBadge variant='primary' theme='warning' icon='alert'>Attention needed</StatusBadge>",
      "<StatusBadge variant='secondary' theme='muted'>Draft</StatusBadge>"
    ],
    "incorrect": [
      "<StatusBadge variant='primary' pulse>Pulse on non-status variant (ignored)</StatusBadge>",
      "<StatusBadge onClick={() => {}}>Status badges are not interactive</StatusBadge>"
    ]
  },
  "x-known-gaps": [
    "No built-in close/dismiss action (use wrapper component if needed)",
    "Pulse animation only works with variant='status'; other variants ignore the pulse prop"
  ],
  "x-governance": {
    "systemRules": [
      "docs/system/accessibility.md",
      "docs/system/color-system.md",
      "docs/system/interaction-states.md",
      "docs/system/visual-primitives.md",
      "docs/system/typography.md",
      "docs/system/spacing.md",
      "docs/system/shadows.md",
      "docs/system/component-architecture.md",
      "docs/system/design-to-code-flow.md"
    ],
    "componentRules": ["schemas/status-badge.md"]
  },
  "x-internal-manifest": "schemas/status-badge.manifest.json"
}
