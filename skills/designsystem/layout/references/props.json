      },
      {
        "name": "justify",
        "type": "enum",
        "values": [
          "start",
          "center",
          "end",
          "between"
        ],
        "default": null,
        "notes": "Main-axis distribution (justify-content), on both Flex and Grid."
      },
      {
        "name": "wrap",
        "type": "enum",
        "values": [
          "nowrap",
