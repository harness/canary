          "sm",
          "md",
          "lg",
          "xl",
          "2xl",
          "3xl",
          "4xl"
        ],
        "default": null,
        "notes": "Horizontal gap only (column-gap)."
      },
      {
        "name": "gapY",
        "type": "enum",
        "values": [
          "none",
          "4xs",
          "3xs",
          "2xs",
          "xs",
          "sm",
          "md",
          "lg",
          "xl",
          "2xl",
          "3xl",
          "4xl"
