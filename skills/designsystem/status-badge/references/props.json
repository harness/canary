{
  "id": "canary.status-badge",
  "code": {
    "package": "@harnessio/ui",
    "export": "StatusBadge",
    "import": "import { StatusBadge } from '@harnessio/ui/components'",
    "path": "packages/ui/src/components/status-badge/status-badge.tsx"
  },
  "props": {
    "shared": [
      {
        "name": "variant",
        "type": "enum",
        "values": [
          "primary",
          "secondary",
          "outline",
          "ghost",
          "status"
        ],
        "default": null,
        "codeNote": "Component style variant. Pass it explicitly; outline is the preferred choice by design convention, not a component default."
      },
      {
        "name": "theme",
        "type": "enum",
        "values": [
          "muted",
          "success",
          "warning",
          "danger",
          "info",
          "merged",
          "risk"
        ],
        "default": "muted",
        "codeNote": "Semantic color theme indicating the status type"
      },
      {
        "name": "size",
        "type": "enum",
        "values": [
          "sm",
          "md"
        ],
        "default": "md",
        "codeNote": "Badge size"
      },
      {
        "name": "children",
        "type": "node",
        "default": null,
        "codeNote": "Badge label/text content"
      }
    ],
    "codeOnly": [
      {
        "name": "icon",
        "type": "string",
        "trigger": "appearance-override",
        "neverWhen": {
          "variant": [
            "status"
          ]
        },
        "notes": "Optional IconV2 name (a key of IconNameMapV2)."
      },
      {
        "name": "pulse",
        "type": "boolean",
        "trigger": "appearance-override",
        "onlyWhen": {
          "variant": [
            "status"
          ]
        },
        "notes": "Animates the status indicator dot (CSS animate-pulse)."
      },
      {
        "name": "className",
        "type": "string",
        "trigger": "appearance-override",
        "notes": "Additional CSS classes (Tailwind); should not override token-based styling"
      }
    ]
  },
  "tokens": {
    "rootClass": "cn-badge",
    "rule": "semantic-only",
    "refs": {
      "variant.primary": "badge.variant.primary",
      "variant.secondary": "badge.variant.secondary",
      "variant.outline": "badge.variant.outline",
      "variant.ghost": "badge.variant.ghost",
      "variant.status": "badge.variant.status",
      "theme.muted": "badge.theme.muted",
      "theme.success": "badge.theme.success",
      "theme.warning": "badge.theme.warning",
      "theme.danger": "badge.theme.danger",
      "theme.info": "badge.theme.info",
      "theme.merged": "badge.theme.merged",
      "theme.risk": "badge.theme.risk",
      "size.sm": "badge.size.sm",
      "size.md": "badge.size.md",
      "animation.pulse": "animation.pulse"
    }
  }
}
